{
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.relaxpromattress.com/",
      "has": [{ "type": "host", "value": "relaxpro-matress.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.relaxpromattress.com/:path*",
      "has": [{ "type": "host", "value": "relaxpro-matress.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.relaxpromattress.com/",
      "has": [{ "type": "host", "value": "remix-relaxpro-matress.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.relaxpromattress.com/:path*",
      "has": [{ "type": "host", "value": "remix-relaxpro-matress.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.relaxpromattress.com/",
      "has": [{ "type": "host", "value": "relaxpromatress.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.relaxpromattress.com/:path*",
      "has": [{ "type": "host", "value": "relaxpromatress.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.relaxpromattress.com/",
      "has": [{ "type": "host", "value": "relaxpro-premium-mattresses.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.relaxpromattress.com/:path*",
      "has": [{ "type": "host", "value": "relaxpro-premium-mattresses.vercel.app" }],
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.relaxpromattress.com/",
      "has": [{ "type": "host", "value": "relaxpromattress.com" }],
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.relaxpromattress.com/:path*",
      "has": [{ "type": "host", "value": "relaxpromattress.com" }],
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; img-src 'self' data: blob: https://cdn.sanity.io; script-src 'self' 'unsafe-inline' https://embed.tawk.to; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://*.sanity.io https://embed.tawk.to https://wa.me; frame-src https://embed.tawk.to; media-src 'self' https://cdn.sanity.io; worker-src 'self' blob:"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
