# Copy to .env.local and fill in your values. .env files are gitignored.

# Required for lead forms & checkout (Google Apps Script Web App URL)
# Deploy google-apps-script.gs as a Web App, then paste the /exec URL here.
VITE_PUBLIC_GOOGLE_SCRIPT_URL=

