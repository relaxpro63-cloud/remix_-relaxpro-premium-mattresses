# Example .env file
# Copy to .env.local and fill in your values. .env files are gitignored.

# Google Sheets Spreadsheet integration Apps Script deployment URL (Web App)
# Used on the client side to submit lead form details and COD orders.
VITE_PUBLIC_GOOGLE_SCRIPT_URL=""

# Canonical site URL (used by sitemap generator, OG tags, and JSON-LD).
# No trailing slash. Keep it the same as your production domain.
VITE_SITE_URL=https://www.relaxpromattress.com
